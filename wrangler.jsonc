{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "let-claude-trade",
  "compatibility_date": "2026-10-01",
  // The market data proxy (ticker symbols only); see worker/index.ts.
  "main": "worker/index.ts",
  // The built site in dist/. Requests are served from it, except /api/*,
  // which goes to the Worker.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
